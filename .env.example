APP_NAME="Teisseire Pizza"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# For Windows + Tailscale Funnel, update this to your real
# https://<device>.<tailnet>.ts.net URL after Funnel is enabled.
APP_URL=https://example.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Europe/Paris

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
AUTH_REGISTRATION_ENABLED=false

# One-time admin provisioning. Use a unique password of at least 16 characters,
# run `php artisan db:seed --class=UserSeeder`, then remove the password value.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=teisseire_menu
DB_USERNAME=teisseire_menu
DB_PASSWORD=change-this-database-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
FILESYSTEM_SERVE_LOCAL=false
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change-this-mail-user
MAIL_PASSWORD=change-this-mail-password
MAIL_FROM_ADDRESS="menu@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# For Tailscale Funnel on this Windows PC, trust only local loopback proxy traffic.
# Use exact proxy IPs/CIDRs for other deployments.
TRUSTED_PROXIES=127.0.0.1,::1

VITE_APP_NAME="${APP_NAME}"
